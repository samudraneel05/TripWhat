# Server
PORT=5000
NODE_ENV=development

# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/tripwhat

# Redis (stream buffer, rate limits, run registry)
REDIS_URL=redis://localhost:6379/0

# Trusted proxy IPs for X-Forwarded-* headers (comma-separated).
# Set to your reverse proxy / LB IPs in production; uvicorn needs
# --proxy-headers (already in the Dockerfile CMD).
FORWARDED_ALLOW_IPS=127.0.0.1

# OpenAI
OPENAI_API_KEY=your_openai_api_key_here

# Tavily (web search tool for the agent)
TAVILY_API_KEY=your_tavily_api_key_here

# LangSmith tracing (optional)
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=tripwhat

# OpenTripMap API
OPENTRIPMAP_API_KEY=your_api_key_here

# SerpApi (Google Flights + Google Hotels)
SERPAPI_API_KEY=your_serpapi_key_here

# Google Places API
GOOGLE_PLACES_API_KEY=your_google_places_key_here

# Viator Partner API (tours & activities in the place panel — free affiliate tier)
VIATOR_API_KEY=
VIATOR_BASE_URL=https://api.sandbox.viator.com/partner

# JWT
JWT_SECRET=your_jwt_secret_here

# CORS
FRONTEND_URL=http://localhost:5173

# Google Calendar + Gmail OAuth (register ALL of these redirect URIs in the
# Google Cloud console OAuth client):
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Login consent (mounted under /api/auth) — handled by app/routes/auth.py:
#   http://localhost:5173/api/auth/google/callback  (proxied) or
#   http://localhost:5000/api/auth/google/callback
# Calendar connect flow:
GOOGLE_REDIRECT_URI=http://localhost:5000/api/google/oauth/callback
# Gmail connect flow:
GMAIL_REDIRECT_URI=http://localhost:5000/api/google/gmail/oauth/callback
# Optional: Fernet key for encrypting Google tokens at rest.
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# If unset, a key is derived from JWT_SECRET.
GOOGLE_TOKEN_ENCRYPTION_KEY=

# Link import (share an IG reel / TikTok / YouTube URL -> saved places)
GOOGLE_VIDEO_UNDERSTANDING_KEY=   # Gemini API key — video understanding tier
APIFY_TOKEN=                      # optional — Apify fallback when yt-dlp is blocked

# Flight search + booking (test mode is free — duffel.com -> Developers -> Access tokens)
DUFFEL_ACCESS_TOKEN=              # duffel_test_... token
ALLOW_LIVE_BOOKINGS=false         # must be true before a duffel_live_ token can create orders

# Google Maps MCP (mapstools.googleapis.com) — bearer token used by the
# agent's place/directions/weather tools
GOOGLE_MCP_ACCESS_TOKEN=

# Agent capacity controls
FALLBACK_MODEL=gpt-4o-mini        # used when the primary model is rate-limited
MAX_CONCURRENT_AGENT_RUNS=8
MAX_RUNS_PER_USER=2
USER_MESSAGES_PER_MINUTE=12
